
#
# Architecture
#
CONFIG_ARCH_ARMV8=y
# CONFIG_ARCH_ARMV7 is not set
# CONFIG_ARCH_ARMV7M is not set
# CONFIG_ARCH_HOST is not set
CONFIG_ARMV8_EL3=y
# CONFIG_ARMV8_RESET_ON_EXCEPTION is not set
# end of Architecture

#
# Platform support
#
CONFIG_SOC_FAMILY_IMX=y
CONFIG_PLAT_CRYPTO_ENGINE=y
CONFIG_PLAT_IMX8X_COMMON=y
# CONFIG_PLAT_IMX8X is not set
CONFIG_PLAT_IMX8XL=y
# CONFIG_PLAT_IMX8MQ is not set
# CONFIG_PLAT_IMX8MP is not set

#
# i.MX8X options
#
# CONFIG_IMX8X_FUSE_DRY_RUN is not set
# end of i.MX8X options

#
# Output image
#
CONFIG_IMX8X_CREATE_IMX_IMAGE=y
# CONFIG_IMX8X_SIGN_IMAGE is not set
# end of Output image
# end of Platform support

#
# Boot
#

#
# Boot source policy: the board's data names the one it uses
#
# CONFIG_BOOT_POLICY_FIXED is not set
# CONFIG_BOOT_POLICY_CHAIN is not set
CONFIG_BOOT_POLICY_AB=y
# CONFIG_BOOT_AB_SPECULATIVE is not set

#
# Handover: what the next stage gets
#
CONFIG_BOOT_DTB=y
CONFIG_BOOT_LINUX=y
# CONFIG_BOOT_FH is not set
CONFIG_BOOT_DTB_HEADROOM=4096

#
# Delivery: how pb starts the next stage
#
CONFIG_BOOT_ATF=y

#
# Loading
#
CONFIG_BOOT_LOAD_CHUNK_kB=4096
# end of Boot

#
# Command mode
#
CONFIG_CM=y
CONFIG_CM_ON_SERIAL_DOWNLOAD=y
CONFIG_CM_BUF_SIZE_KiB=4096
CONFIG_CM_TRANSPORT_READY_TIMEOUT=10
CONFIG_CM_TRANSFER_TIMEOUT=10
CONFIG_CM_AUTH=y
CONFIG_CM_AUTH_TOKEN=y
CONFIG_CM_AUTH_PASSWORD=y
CONFIG_IMX8X_CM_USB_OTG2=y
# end of Command mode

#
# Keys and life cycle
#
CONFIG_SRK_FUSE="pki/imx8x_ahab/crts/SRK_1_2_3_4_fuse.bin"
# CONFIG_SLC_EOL is not set
# end of Keys and life cycle

#
# Logging
#
CONFIG_LOGLEVEL=3
CONFIG_PRINT_BOOT_BANNER=y
# CONFIG_RAMLOG is not set
# CONFIG_BOOT_LINUX_RAMOOPS is not set
# end of Logging

#
# Core
#

#
# Watchdog
#
CONFIG_ENABLE_WATCHDOG=y
CONFIG_WATCHDOG_TIMEOUT=10

#
# Limits
#
CONFIG_CRYPTO_MAX_HASH_OPS=1
CONFIG_CRYPTO_MAX_DSA_OPS=1
CONFIG_BIO_MAX_DEVS=128
CONFIG_BIO_MAX_BLOCK_SIZE=4096
# end of Core

#
# Drivers
#
CONFIG_HAVE_IMX_CAAM=y

#
# Crypto
#
CONFIG_DRIVERS_IMX_CAAM=y
# CONFIG_DRIVERS_CRYPTO_MBEDTLS is not set
# end of Crypto

#
# Fuses
#
# CONFIG_DRIVERS_FUSE_TEST is not set
# end of Fuses

#
# GPIO
#
CONFIG_DRIVERS_IMX_GPIO=y
# end of GPIO

#
# Memory controllers
#
# CONFIG_IMX_FLEXSPI is not set
# end of Memory controllers

#
# MMC and SD
#
CONFIG_MMC_CORE=y
CONFIG_MMC_CORE_MAX_DEVICES=1
# CONFIG_MMC_CORE_DEBUG_CMDS is not set
# CONFIG_MMC_CORE_DEBUG_IOS is not set
# CONFIG_MMC_CORE_HS200_TUNE is not set
# CONFIG_MMC_CORE_OVERRIDE_BOOT_PART_SZ is not set
CONFIG_IMX_USDHC=y
CONFIG_IMX_USDHC_MAX_INSTANCES=1
# end of MMC and SD

#
# Partition tables
#
CONFIG_PARTITION_GPT=y
# CONFIG_PARTITION_STATIC is not set
# end of Partition tables

#
# Timers
#
CONFIG_DRIVERS_IMX_GPT=y
# end of Timers

CONFIG_HAVE_IMX_LPUART=y

#
# UART
#
CONFIG_DRIVERS_IMX_LPUART=y
# end of UART

CONFIG_HAVE_IMX_CI_UDC=y

#
# USB
#
CONFIG_DRIVER_USB_DEVICE=y
CONFIG_DRIVER_USB_PB_CLS=y
CONFIG_DRIVER_IMX_USB2_PHY=y
CONFIG_DRIVER_IMX_CI_UDC=y
CONFIG_DRIVER_IMX_USBDCD=y
# end of USB

#
# Virtio
#
# CONFIG_DRIVER_VIRTIO_BLOCK is not set
# CONFIG_DRIVER_VIRTIO_SERIAL is not set
# end of Virtio

#
# Watchdog
#
# end of Watchdog
# end of Drivers

#
# Library
#
CONFIG_LIB_DER_HELPERS=y
CONFIG_LIB_FDT=y
CONFIG_LIB_XLAT_TBLS=y
CONFIG_LIB_XLAT_TBLS_ARMV8=y
# end of Library

#
# Build
#
CONFIG_OPTIMIZE="2"
# CONFIG_DEBUG_SYMBOLS is not set
CONFIG_STACK_SIZE_KiB=16
CONFIG_LINK_FILE="src/link.lds"
# end of Build
