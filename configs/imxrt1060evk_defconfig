
#
# Architecture
#
# CONFIG_ARCH_ARMV8 is not set
# CONFIG_ARCH_ARMV7 is not set
CONFIG_ARCH_ARMV7M=y
# CONFIG_ARCH_HOST is not set
# end of Architecture

#
# Platform support
#
CONFIG_SOC_FAMILY_IMX=y
CONFIG_PLAT_CRYPTO_ENGINE=y
CONFIG_PLAT_IMXRT=y

#
# Output image
#
CONFIG_IMXRT_CREATE_IMX_IMAGE=y
CONFIG_IMXRT_CREATE_FLASH_IMAGE=y
# end of Output image
# end of Platform support

CONFIG_BOARD_IMXRT1060EVK_REV_A=y
# CONFIG_BOARD_IMXRT1060EVK_REV_B is not set
# CONFIG_BOARD_IMXRT1060EVK_REV_C is not set

#
# Boot
#

#
# Boot source policy: the board's data names the one it uses
#
# CONFIG_BOOT_POLICY_FIXED is not set
# CONFIG_BOOT_POLICY_CHAIN is not set
CONFIG_BOOT_POLICY_AB=y
# CONFIG_BOOT_AB_SPECULATIVE is not set

#
# Handover: what the next stage gets
#
CONFIG_BOOT_DTB=y
# CONFIG_BOOT_LINUX is not set
CONFIG_BOOT_FH=y
CONFIG_BOOT_FH_REGION_BASE=0x20208000
CONFIG_BOOT_FH_REGION_SIZE=0x1000
CONFIG_BOOT_DTB_HEADROOM=4096

#
# Loading
#
CONFIG_BOOT_LOAD_CHUNK_kB=4
# end of Boot

#
# Command mode
#
CONFIG_CM=y
CONFIG_CM_ON_SERIAL_DOWNLOAD=y
CONFIG_CM_BUF_SIZE_KiB=32
CONFIG_CM_TRANSPORT_READY_TIMEOUT=10
CONFIG_CM_TRANSFER_TIMEOUT=10
CONFIG_CM_AUTH=y
CONFIG_CM_AUTH_TOKEN=y
# CONFIG_CM_AUTH_PASSWORD is not set
CONFIG_IMXRT_CM_USB_OTG1=y
# end of Command mode

#
# Keys and life cycle
#
CONFIG_SRK_FUSE=""
# CONFIG_SLC_EOL is not set
# end of Keys and life cycle

#
# Logging
#
CONFIG_LOGLEVEL=1
CONFIG_PRINT_BOOT_BANNER=y
CONFIG_RAMLOG=y
CONFIG_RAMLOG_SIZE_KiB=16
# CONFIG_BOOT_LINUX_RAMOOPS is not set
# end of Logging

#
# Core
#

#
# Watchdog
#
CONFIG_ENABLE_WATCHDOG=y
CONFIG_WATCHDOG_TIMEOUT=30

#
# Limits
#
CONFIG_CRYPTO_MAX_HASH_OPS=3
CONFIG_CRYPTO_MAX_DSA_OPS=3
CONFIG_BIO_MAX_DEVS=16
CONFIG_BIO_MAX_BLOCK_SIZE=4096
# end of Core

#
# Drivers
#

#
# Crypto
#
CONFIG_DRIVERS_CRYPTO_MBEDTLS=y
CONFIG_MBEDTLS_MD_SHA256=y
# CONFIG_MBEDTLS_MD_SHA384 is not set
# CONFIG_MBEDTLS_MD_SHA512 is not set
CONFIG_MBEDTLS_MD_MD5=y
CONFIG_MBEDTLS_ECDSA=y
# CONFIG_MBEDTLS_STRERROR is not set
# end of Crypto

CONFIG_HAVE_IMX_OCOTP=y

#
# Fuses
#
# CONFIG_DRIVERS_FUSE_TEST is not set
CONFIG_DRIVERS_FUSE_IMX_OCOTP=y
# CONFIG_IMX_OCOTP_DEBUG is not set
# end of Fuses

#
# GPIO
#
CONFIG_DRIVERS_IMX_GPIO=y
# end of GPIO

#
# Memory controllers
#
CONFIG_IMX_FLEXSPI=y
# end of Memory controllers

#
# MMC and SD
#
# CONFIG_MMC_CORE is not set
# CONFIG_IMX_USDHC is not set
# end of MMC and SD

#
# Partition tables
#
# CONFIG_PARTITION_GPT is not set
CONFIG_PARTITION_STATIC=y
# end of Partition tables

CONFIG_DRIVERS_IMX_HAB_LOG=y

#
# Timers
#
CONFIG_DRIVERS_IMX_GPT=y
# end of Timers

CONFIG_HAVE_IMX_LPUART=y

#
# UART
#
CONFIG_DRIVERS_IMX_LPUART=y
# end of UART

CONFIG_HAVE_IMX_CI_UDC=y

#
# USB
#
CONFIG_DRIVER_USB_DEVICE=y
CONFIG_DRIVER_USB_PB_CLS=y
CONFIG_DRIVER_IMX_USB2_PHY=y
CONFIG_DRIVER_IMX_CI_UDC=y
# CONFIG_DRIVER_IMX_USBDCD is not set
# end of USB

#
# Virtio
#
# CONFIG_DRIVER_VIRTIO_BLOCK is not set
# CONFIG_DRIVER_VIRTIO_SERIAL is not set
# end of Virtio

CONFIG_HAVE_IMX_WDOG=y

#
# Watchdog
#
CONFIG_DRIVERS_IMX_WDOG=y
# CONFIG_DRIVERS_IMX_WDOG_DEBUG is not set
# CONFIG_DRIVERS_IMX_WDOG_WAIT is not set
# end of Watchdog
# end of Drivers

#
# Library
#
CONFIG_LIB_DER_HELPERS=y
CONFIG_LIB_FDT=y
# end of Library

#
# Build
#
CONFIG_OPTIMIZE="s"
# CONFIG_DEBUG_SYMBOLS is not set
CONFIG_STACK_SIZE_KiB=4
CONFIG_LINK_FILE="src/link.lds"
# end of Build
