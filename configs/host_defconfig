# Native host build used by the unit and integration tests (CMakeLists.txt).
CONFIG_ARCH_HOST=y
CONFIG_PLAT_HOST=y
CONFIG_KEYSTORE="pki/internal_keystore.bpak"
CONFIG_LOGLEVEL=3
# CONFIG_ENABLE_WATCHDOG is not set
CONFIG_PRINT_BOOT_BANNER=y
CONFIG_DEVICE_UUID=y
CONFIG_CRYPTO=y
CONFIG_BIO_CORE=y
CONFIG_BIO_MAX_DEVS=32
# CONFIG_SELF_TEST is not set
CONFIG_BOOT_CORE=y
CONFIG_BOOT_BPAK_IMAGE_HELPERS=y
CONFIG_BOOT_AB_DRIVER=y
CONFIG_BOOT_LINUX=y
CONFIG_BOOT_LOAD_CHUNK_kB=4096
CONFIG_DRIVERS_CRYPTO_MBEDTLS=y
CONFIG_MBEDTLS_MD_SHA256=y
CONFIG_MBEDTLS_MD_SHA384=y
CONFIG_MBEDTLS_MD_SHA512=y
CONFIG_MBEDTLS_MD_MD5=y
CONFIG_MBEDTLS_ECDSA=y
CONFIG_MBEDTLS_STRERROR=y
CONFIG_DRIVERS_FUSE_TEST=y
CONFIG_PARTITION_GPT=y
# CONFIG_DRIVER_VIRTIO_BLOCK is not set
# CONFIG_DRIVER_VIRTIO_SERIAL is not set
# CONFIG_DRIVER_USB_DEVICE is not set
CONFIG_CM=y
CONFIG_CM_BUF_SIZE_KiB=4
CONFIG_CM_TRANSPORT_READY_TIMEOUT=10
CONFIG_CM_AUTH=y
CONFIG_CM_AUTH_TOKEN=y
CONFIG_CM_AUTH_PASSWORD=y
CONFIG_LIB_ZLIB_CRC=y
CONFIG_LIB_BPAK=y
CONFIG_LIB_DER_HELPERS=y
CONFIG_LIB_FDT=y
CONFIG_LIB_UUID=y
CONFIG_LIB_UUID3=y
# CONFIG_LIB_XLAT_TBLS is not set
