
#
# Architecture
#
# CONFIG_ARCH_ARMV8 is not set
CONFIG_ARCH_ARMV7=y
# CONFIG_ARCH_ARMV7M is not set
# CONFIG_ARCH_HOST is not set
# end of Architecture

#
# Platform support
#
CONFIG_SOC_FAMILY_IMX=y
CONFIG_PLAT_CRYPTO_ENGINE=y
CONFIG_PLAT_IMX6UL=y

#
# Output image
#
CONFIG_IMX6UL_CREATE_IMX_IMAGE=y
CONFIG_IMX6UL_SIGN_IMAGE=y
CONFIG_IMX6UL_SRK_TABLE="pki/imx6ul_hab_testkeys/SRK_1_2_3_4_table.bin"
CONFIG_IMX6UL_KEY_INDEX=0
CONFIG_IMX6UL_SIGN_CERT="pki/imx6ul_hab_testkeys/CSF1_1_sha256_4096_65537_v3_usr_crt.pem"
CONFIG_IMX6UL_IMAGE_SIGN_CERT="pki/imx6ul_hab_testkeys/IMG1_1_sha256_4096_65537_v3_usr_crt.pem"
# end of Output image
# end of Platform support

#
# Boot
#

#
# Boot source policy: the board's data names the one it uses
#
# CONFIG_BOOT_POLICY_FIXED is not set
# CONFIG_BOOT_POLICY_CHAIN is not set
CONFIG_BOOT_POLICY_AB=y
# CONFIG_BOOT_AB_SPECULATIVE is not set

#
# Handover: what the next stage gets
#
CONFIG_BOOT_DTB=y
CONFIG_BOOT_LINUX=y
# CONFIG_BOOT_FH is not set
CONFIG_BOOT_DTB_HEADROOM=4096

#
# Loading
#
CONFIG_BOOT_LOAD_CHUNK_kB=1024
# end of Boot

#
# Command mode
#
CONFIG_CM=y
CONFIG_CM_ON_SERIAL_DOWNLOAD=y
CONFIG_CM_BUF_SIZE_KiB=4096
CONFIG_CM_TRANSPORT_READY_TIMEOUT=10
CONFIG_CM_TRANSFER_TIMEOUT=10
CONFIG_CM_AUTH=y
CONFIG_CM_AUTH_TOKEN=y
# CONFIG_CM_AUTH_PASSWORD is not set
CONFIG_IMX6UL_CM_USB_OTG1=y
# end of Command mode

#
# Keys and life cycle
#
CONFIG_SRK_FUSE="pki/imx6ul_hab_testkeys/SRK_1_2_3_4_fuse.bin"
# CONFIG_SLC_EOL is not set
# end of Keys and life cycle

#
# Logging
#
CONFIG_LOGLEVEL=1
CONFIG_PRINT_BOOT_BANNER=y
CONFIG_RAMLOG=y
CONFIG_RAMLOG_SIZE_KiB=16
CONFIG_BOOT_LINUX_RAMOOPS=y
CONFIG_BOOT_LINUX_RAMOOPS_ADDR=0xbff00000
CONFIG_BOOT_LINUX_RAMOOPS_SIZE=0x100000
CONFIG_BOOT_LINUX_RAMOOPS_RECORD_SIZE=0x20000
CONFIG_BOOT_LINUX_RAMOOPS_CONSOLE_SIZE=0x0
CONFIG_BOOT_LINUX_RAMOOPS_FTRACE_SIZE=0x0
CONFIG_BOOT_LINUX_RAMOOPS_PMSG_SIZE=0x0
# end of Logging

#
# Core
#

#
# Watchdog
#
CONFIG_ENABLE_WATCHDOG=y
CONFIG_WATCHDOG_TIMEOUT=5

#
# Limits
#
CONFIG_CRYPTO_MAX_HASH_OPS=1
CONFIG_CRYPTO_MAX_DSA_OPS=1
CONFIG_BIO_MAX_DEVS=32
CONFIG_BIO_MAX_BLOCK_SIZE=4096
# end of Core

#
# Drivers
#
CONFIG_HAVE_IMX_CAAM=y

#
# Crypto
#
CONFIG_DRIVERS_IMX_CAAM=y
# CONFIG_DRIVERS_CRYPTO_MBEDTLS is not set
# end of Crypto

CONFIG_HAVE_IMX_OCOTP=y

#
# Fuses
#
# CONFIG_DRIVERS_FUSE_TEST is not set
CONFIG_DRIVERS_FUSE_IMX_OCOTP=y
# CONFIG_IMX_OCOTP_DEBUG is not set
# end of Fuses

#
# GPIO
#
CONFIG_DRIVERS_IMX_GPIO=y
# end of GPIO

#
# Memory controllers
#
# CONFIG_IMX_FLEXSPI is not set
# end of Memory controllers

#
# MMC and SD
#
CONFIG_MMC_CORE=y
CONFIG_MMC_CORE_MAX_DEVICES=1
# CONFIG_MMC_CORE_DEBUG_CMDS is not set
# CONFIG_MMC_CORE_DEBUG_IOS is not set
# CONFIG_MMC_CORE_HS200_TUNE is not set
# CONFIG_MMC_CORE_OVERRIDE_BOOT_PART_SZ is not set
CONFIG_IMX_USDHC=y
CONFIG_IMX_USDHC_MAX_INSTANCES=1
# end of MMC and SD

#
# Partition tables
#
CONFIG_PARTITION_GPT=y
# CONFIG_PARTITION_STATIC is not set
# end of Partition tables

CONFIG_DRIVERS_IMX_ROM_LOG=y
CONFIG_DRIVERS_IMX_HAB_LOG=y

#
# Timers
#
CONFIG_DRIVERS_IMX_GPT=y
# end of Timers

CONFIG_DRIVERS_TZC380=y
CONFIG_HAVE_IMX_UART=y

#
# UART
#
CONFIG_DRIVERS_IMX_UART=y
# end of UART

CONFIG_HAVE_IMX_CI_UDC=y

#
# USB
#
CONFIG_DRIVER_USB_DEVICE=y
CONFIG_DRIVER_USB_PB_CLS=y
CONFIG_DRIVER_IMX_USB2_PHY=y
CONFIG_DRIVER_IMX_CI_UDC=y
# CONFIG_DRIVER_IMX_USBDCD is not set
# end of USB

#
# Virtio
#
# CONFIG_DRIVER_VIRTIO_BLOCK is not set
# CONFIG_DRIVER_VIRTIO_SERIAL is not set
# end of Virtio

CONFIG_HAVE_IMX_WDOG=y

#
# Watchdog
#
CONFIG_DRIVERS_IMX_WDOG=y
CONFIG_DRIVERS_IMX_WDOG_DEBUG=y
# CONFIG_DRIVERS_IMX_WDOG_WAIT is not set
# end of Watchdog
# end of Drivers

#
# Library
#
CONFIG_LIB_DER_HELPERS=y
CONFIG_LIB_FDT=y
CONFIG_LIB_XLAT_TBLS=y
CONFIG_LIB_XLAT_TBLS_ARMV7=y
# end of Library

#
# Build
#
CONFIG_OPTIMIZE="2"
# CONFIG_DEBUG_SYMBOLS is not set
CONFIG_STACK_SIZE_KiB=16
CONFIG_LINK_FILE="src/link.lds"
# end of Build
