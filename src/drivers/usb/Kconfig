# Selected by the platforms whose SoC has it (platform.md 6.1)
# The ChipIdea controller, with the USB2 PHY and the charger detection
config HAVE_IMX_CI_UDC
    bool

config HAVE_IMX_CDNS3_UDC
    bool

# The DWC3 controller with the i.MX8M's PHY
config HAVE_IMX_DWC3_UDC
    bool

menu "USB"

config DRIVER_USB_DEVICE
    bool "USB device stack"
    default y

config DRIVER_USB_PB_CLS
    bool "Punchboot device class"
    default y
    depends on DRIVER_USB_DEVICE

config DRIVER_IMX_USB2_PHY
    bool "i.MX USB2 PHY"
    depends on HAVE_IMX_CI_UDC
    default y

config DRIVER_IMX_CI_UDC
    bool "i.MX ChipIdea device controller"
    depends on HAVE_IMX_CI_UDC
    depends on DRIVER_USB_DEVICE
    # Command mode's transport: its descriptors are sized by CM_BUF_SIZE_KiB
    depends on CM
    default y

config DRIVER_IMX_USBDCD
    bool "i.MX USB charger detection"
    depends on HAVE_IMX_CI_UDC
    depends on DRIVER_USB_DEVICE

config DRIVER_IMX_CDNS3_UDC
    bool "i.MX Cadence USB3 device controller"
    depends on HAVE_IMX_CDNS3_UDC

config DRIVER_IMX_DWC3_UDC
    bool "i.MX DWC3 device controller"
    depends on HAVE_IMX_DWC3_UDC

config DRIVER_IMX8M_PHY
    bool "i.MX8M USB PHY"
    depends on HAVE_IMX_DWC3_UDC

endmenu
