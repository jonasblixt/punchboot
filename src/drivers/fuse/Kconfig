# Selected by the platforms whose SoC has it (platform.md 6.1)
config HAVE_IMX_OCOTP
    bool

menu "Fuses"

config DRIVERS_FUSE_TEST
    bool "Test fuse box on a block device"
    help
        A fuse box kept in a block device, for the host build's tests.

config DRIVERS_FUSE_IMX_OCOTP
    bool "i.MX OCOTP"
    depends on HAVE_IMX_OCOTP

config IMX_OCOTP_DEBUG
    bool "Debug output"
    depends on DRIVERS_FUSE_IMX_OCOTP

endmenu
