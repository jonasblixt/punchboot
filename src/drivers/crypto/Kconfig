# Selected by the platforms whose SoC has it (platform.md 6.1)
config HAVE_IMX_CAAM
    bool

menu "Crypto"

config DRIVERS_IMX_CAAM
    bool "i.MX CAAM"
    depends on HAVE_IMX_CAAM
    default y
    select LIB_DER_HELPERS
    help
        The i.MX crypto engine: hashes, signature verification and the
        RNG, set up in plat_init() (crypto.md).

menuconfig DRIVERS_CRYPTO_MBEDTLS
    bool "Mbed TLS (software)"

if DRIVERS_CRYPTO_MBEDTLS
source "src/drivers/crypto/mbedtls/Kconfig"
endif

endmenu
