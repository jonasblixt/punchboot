menu "MMC and SD"

config MMC_CORE
    bool "MMC core (e.MMC, SD)"

config MMC_CORE_MAX_DEVICES
    int "Cards"
    depends on MMC_CORE
    default 1
    help
        How many cards (e.MMC, SD) the board initializes.

config MMC_CORE_DEBUG_CMDS
    bool "Debug: log the commands"
    depends on MMC_CORE

config MMC_CORE_DEBUG_IOS
    bool "Debug: log the reads and writes"
    depends on MMC_CORE

config MMC_CORE_HS200_TUNE
    bool "HS200 tuning"
    depends on MMC_CORE
    help
        Pick the delay tap in HS200 with CMD21 tuning blocks instead of
        using the board's: every tap is tried and the middle of the widest
        working window is used. One CMD21 per tap, about 2 ms for 128 taps
        at 200 MHz. If no tap works the card runs in high speed (52 MHz)
        with the board's tap, so a marginal board still boots.

config MMC_CORE_OVERRIDE_BOOT_PART_SZ
    bool "Override the boot partitions' size"
    depends on MMC_CORE
    help
        Most products leave this off. Use the size below instead of the
        one the card's EXT_CSD reports for its boot partitions.

config MMC_CORE_BOOT_PART_SZ_KiB
    int "Boot partition size (KiB)"
    depends on MMC_CORE_OVERRIDE_BOOT_PART_SZ
    default 0

config IMX_USDHC
    bool "i.MX uSDHC"
    depends on SOC_FAMILY_IMX
    select MMC_CORE

config IMX_USDHC_MAX_INSTANCES
    int "uSDHC controllers"
    depends on IMX_USDHC
    default 1
    help
        How many uSDHC controllers the board uses. Each has a 4 KiB ADMA2
        descriptor table.

endmenu
