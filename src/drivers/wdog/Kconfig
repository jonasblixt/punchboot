# Selected by the platforms whose SoC has it (platform.md 6.1)
config HAVE_IMX_WDOG
    bool

menu "Watchdog"

config DRIVERS_IMX_WDOG
    bool "i.MX WDOG"
    depends on HAVE_IMX_WDOG

config DRIVERS_IMX_WDOG_DEBUG
    bool "Paused while the core is halted (debug)"
    depends on DRIVERS_IMX_WDOG
    help
        WDOG_WCR's WDBG: the watchdog doesn't count while a debugger
        halts the core.

config DRIVERS_IMX_WDOG_WAIT
    bool "Paused in wait mode"
    depends on DRIVERS_IMX_WDOG
    help
        WDOG_WCR's WDW: the watchdog doesn't count in the low power wait
        mode.

endmenu
