source "src/drivers/*/Kconfig"
endmenu

source "src/lib/Kconfig"

menu "Build"

choice EXECUTE
    bool "pb runs from"
config EXECUTE_IN_RAM
    bool "RAM"
config EXECUTE_IN_FLASH
    bool "Flash (XIP)"
endchoice

config OPTIMIZE
    string "Optimization level"
    help
        What follows -O: 0, 1, 2, 3, s, z or g.

config DEBUG_SYMBOLS
    bool "Debug symbols (-g)"

config STACK_SIZE_KiB
    int "Stack size (KiB)"
    default 2

config LINK_FILE
    string "Link script"
    default "src/link.lds" if EXECUTE_IN_RAM
    default "src/link_flash.lds" if EXECUTE_IN_FLASH
    help
        pb's sections. The platform's link script, with the memory, comes
        before it (platform.md 5.1).

endmenu
