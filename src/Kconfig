menu "Command mode"
source "src/cm/Kconfig"
# The platform's choice of the USB port (platform.md 3.10)
osource "src/plat/*/Kconfig.cm"
endmenu

menu "Keys and life cycle"

config KEYSTORE
    string "Keystore (bpak file)"
    default "pki/internal_keystore.bpak"
    help
        The keys pb verifies images and command mode's tokens with, built
        into pb (bpak generate keystore).

config KEYSTORE_SLOTS
    string "Revoke slots of the keys"
    default ""
    help
        The keystore's key ids (hex, space separated) in the order of their
        revoke slots: the n-th is slot n, on HABv4 SRK n's revoke fuse. A key
        dropped from the keystore keeps its place here, so the keys after it
        keep their slots. Every key in the keystore needs one.
        Empty: the keystore's order. A key must then never be removed from
        the keystore or moved, also not after it is revoked (F-165).

config SRK_FUSE
    string "SRK hash fuse words"
    default ""
    help
        srktool's fuse file (e.g. SRK_1_2_3_4_fuse.bin) of the keys pb is
        signed with, for a board that fuses the SRK hash in
        slc_set_configuration() (include/pb/srk_fuse.h).

config SLC_EOL
    bool "End of life (EOL) as a life cycle state the device can enter"
    depends on CM
    help
        The product's choice (system.md 4). On: SLC_SET_EOL moves the device
        to the SoC's end of life state through the port's set_eol, where the
        port has one. It can't be undone, and command mode is open again in
        that state (D-011).

        Off, the default: the device can't enter EOL. SLC_SET_EOL answers
        NOT_SUPPORTED and slc_set_eol() calls nothing of the port's
        (command-mode.md 4.5, 5.2). A device that is in EOL already still
        reads as that.

endmenu

menu "Logging"

config LOGLEVEL
    int "Console log level"
    default 0
    help
        What the console (UART) prints: 0 nothing, 1 errors, 2 also
        warnings and info, 3 also debug. With CONFIG_RAMLOG the RAM log has
        the levels up to CONFIG_RAMLOG_LOGLEVEL (include/pb/log_def.h).

config PRINT_BOOT_BANNER
    bool "Boot banner"
    default y
    help
        pb's version and the boot reason on the console when it is set up.

config RAMLOG
    bool "A copy of the console output in RAM"
    help
        Everything written to the console is also kept in a ring buffer in
        RAM, the symbol 'ramlog' in the .ramlog section (not zeroed, in the
        RAM pb runs from). It can be read without a UART: over JTAG,
        through a boot ROM USB loader (FEL) or from a RAM dump. The layout
        is struct pb_ramlog_hdr in include/pb/ramlog.h.

        Output from before console_init() (early debug prints) goes only
        to the RAM log, and is written to the UART when console_init()
        sets it up. If there was more early output than the log holds,
        only the newest RAMLOG_SIZE_KiB is written out.

config RAMLOG_SIZE_KiB
    int "RAM log size (KiB)"
    default 16
    depends on RAMLOG

config RAMLOG_LOGLEVEL
    int "RAM log level"
    default 3
    range 0 3
    depends on RAMLOG
    help
        Log messages up to this level go to the RAM log, also the ones
        above LOGLEVEL, which the console doesn't print (3: debug, 2: info,
        1: warnings and errors). So the UART can stay quiet and fast while
        the RAM log has the whole story. A level at or below LOGLEVEL
        changes nothing.

        The messages up to this level are compiled in, so a level above
        LOGLEVEL makes pb larger: debug adds about 8 KiB over info on
        jiffy.

config RAMLOG_SYNC
    bool "Synchronized RAM log (for debugging)"
    depends on RAMLOG
    help
        Clean the data cache after every character, so that the log in RAM
        is always current, also when pb hangs or crashes and the log is read
        from outside (JTAG, FEL, a RAM dump after a warm reset). This costs
        two cache line cleans per character.

endmenu

menu "Core"

comment "Watchdog"

config ENABLE_WATCHDOG
    bool "Watchdog"
    default y
    help
        The platform arms the SoC's watchdog in plat_early_init(), and pb
        kicks it while it works. Speculative mode needs it.

config WATCHDOG_TIMEOUT
    int "Timeout (s)"
    default 5
    depends on ENABLE_WATCHDOG

comment "Limits"

config CRYPTO_MAX_HASH_OPS
    int "Hash backends, at most"
    default 1
    help
        How many hash implementations can be registered (pb/crypto.h).

config CRYPTO_MAX_DSA_OPS
    int "Signature (DSA) backends, at most"
    default 1
    help
        How many signature verification implementations can be
        registered (pb/crypto.h).

config BIO_MAX_DEVS
    int "Block devices, at most"
    default 32

config BIO_MAX_BLOCK_SIZE
    int "Largest block size (bytes)"
    default 4096
    help
        A block device with larger blocks is refused when it is registered
        (bio.md 2.3).

endmenu

