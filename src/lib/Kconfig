menu "Library"

config LIB_DER_HELPERS
    bool "ASN.1 DER helpers"
    default y

config LIB_FDT
    bool "Device tree library (libfdt)"
    default y
    help
        Selected by the handovers that pass a device tree on; a board may
        use it too.

# The translation tables (xlat_tables_v2), which the platforms on an arch
# with an MMU set it up with: no switch, as they don't build without them
config LIB_XLAT_TBLS
    bool

config LIB_XLAT_TBLS_ARMV7
    bool
    default y if ARCH_ARMV7
    select LIB_XLAT_TBLS

config LIB_XLAT_TBLS_ARMV8
    bool
    default y if ARCH_ARMV8
    select LIB_XLAT_TBLS

# The room in the translation tables (platform.md 5.1, 5.2). The platform
# gives the default in its Kconfig, which is read before this one; a board
# with many regions in its mmap (board.md 2.8) raises them in its defconfig
config MAX_MMAP_REGIONS
    int "Memory map regions, at most"
    depends on LIB_XLAT_TBLS
    range 8 256
    help
        The regions the memory map holds (platform.md 5.2): the board's
        DRAM, the platform's, the board's mmap and pb's six. pb_mmu_init()
        refuses a map with more, and plat_init() fails. Each is 32 bytes
        in pb's memory.

config MAX_XLAT_TABLES
    int "Translation tables, at most"
    depends on LIB_XLAT_TBLS
    range 1 256
    help
        The translation tables the memory map may take, 4 KiB each, in
        pb's buffers, whose size the linker checks. A region that isn't
        aligned to a block takes tables of its own.

endmenu
