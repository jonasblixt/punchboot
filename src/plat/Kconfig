menu "Platform support"

config SOC_FAMILY_IMX
    bool "NXP i.MX SoCs"

# The platform sets the build's crypto backends up in plat_init(), what the
# boot verifies with (platform.md 2.2). A boot is refused when one failed: the
# boot's preconditions check plat_get_status()'s crypto_engine in a build
# that has this (platform.md 2.3). Every platform in the tree selects it
# (F-247); one that doesn't reports no engine, and the core doesn't ask.
config PLAT_CRYPTO_ENGINE
    bool

config PLAT_IMX8X_COMMON
    bool
    select PLAT_CRYPTO_ENGINE
    select HAVE_IMX_CAAM
    select HAVE_IMX_LPUART
    select HAVE_IMX_CI_UDC

# Shared by the i.MX8M SoCs: platform code in src/plat/imx8m, DDR drivers
config PLAT_IMX8M_COMMON
    bool
    select PLAT_CRYPTO_ENGINE
    select DRIVERS_DDR_UMCTL2
    select DRIVERS_DDR_DWC_PHY
    select DRIVERS_TZC380
    select DRIVERS_IMX_ROM_LOG
    select DRIVERS_IMX_HAB_LOG
    select HAVE_IMX_CAAM
    select HAVE_IMX_OCOTP
    select HAVE_IMX_UART
    select HAVE_IMX_WDOG
    select HAVE_IMX_DWC3_UDC

choice PLAT
    bool "Platform"
config PLAT_IMX8X
    bool "NXP i.MX8QXP (i.MX8X)"
    depends on SOC_FAMILY_IMX
    depends on ARCH_ARMV8
    select PLAT_IMX8X_COMMON
    select HAVE_IMX_CDNS3_UDC
config PLAT_IMX8XL
    bool "NXP i.MX8DXL (i.MX8X)"
    depends on SOC_FAMILY_IMX
    depends on ARCH_ARMV8
    select PLAT_IMX8X_COMMON
config PLAT_IMX8MQ
    bool "NXP i.MX8MQ"
    depends on SOC_FAMILY_IMX
    depends on ARCH_ARMV8
    select PLAT_IMX8M_COMMON
config PLAT_IMX8MP
    bool "NXP i.MX8M Plus"
    depends on SOC_FAMILY_IMX
    depends on ARCH_ARMV8
    select PLAT_IMX8M_COMMON
config PLAT_IMX6UL
    bool "NXP i.MX6UL"
    depends on SOC_FAMILY_IMX
    depends on ARCH_ARMV7
    select PLAT_CRYPTO_ENGINE
    select DRIVERS_TZC380
    select DRIVERS_IMX_ROM_LOG
    select DRIVERS_IMX_HAB_LOG
    select HAVE_IMX_CAAM
    select HAVE_IMX_OCOTP
    select HAVE_IMX_UART
    select HAVE_IMX_WDOG
    select HAVE_IMX_CI_UDC
config PLAT_IMXRT
    bool "NXP i.MX RT"
    depends on SOC_FAMILY_IMX
    depends on ARCH_ARMV7M
    select DRIVERS_IMX_HAB_LOG
    select PLAT_CRYPTO_ENGINE
    select HAVE_IMX_OCOTP
    select HAVE_IMX_LPUART
    select HAVE_IMX_WDOG
    select HAVE_IMX_CI_UDC

config PLAT_HOST
    bool "Host (native Linux process, for testing)"
    depends on ARCH_HOST
    select PLAT_CRYPTO_ENGINE
endchoice

source "src/plat/*/Kconfig"

endmenu
