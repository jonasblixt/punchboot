menu "Platform support"

config SOC_FAMILY_IMX
	bool "NXP i.MX SoC's"
    default n

# The platform sets a crypto engine up in plat_init(), the one the boot
# verifies with (platform.md 2.2). A boot is refused when it failed: the
# boot's preconditions check plat_get_status()'s crypto_engine in a build
# that has this (platform.md 2.3). A platform whose boards set the engine up
# doesn't select it (F-247).
config PLAT_CRYPTO_ENGINE
    bool
    default n

config PLAT_IMX8X_COMMON
    bool
    default n

# Shared by the i.MX8M SoCs: platform code in src/plat/imx8m, DDR drivers
config PLAT_IMX8M_COMMON
    bool
    default n
    select DRIVERS_DDR_UMCTL2
    select DRIVERS_DDR_DWC_PHY
    select DRIVERS_TZC380
    select DRIVERS_IMX_ROM_LOG
    select DRIVERS_IMX_HAB_LOG

choice PLAT
    bool "Platform"
config PLAT_IMX8X
    bool "NXP IMX8X"
    depends on SOC_FAMILY_IMX
    depends on ARCH_ARMV8
    select PLAT_IMX8X_COMMON
config PLAT_IMX8XL
    bool "NXP IMX8X Light"
    depends on SOC_FAMILY_IMX
    depends on ARCH_ARMV8
    select PLAT_IMX8X_COMMON
config PLAT_IMX8MQ
    bool "NXP i.MX8MQ"
    depends on SOC_FAMILY_IMX
    depends on ARCH_ARMV8
    select PLAT_IMX8M_COMMON
config PLAT_IMX8MP
    bool "NXP i.MX8M Plus"
    depends on SOC_FAMILY_IMX
    depends on ARCH_ARMV8
    select PLAT_IMX8M_COMMON
config PLAT_IMX6UL
    bool "NXP IMX6UL"
    depends on SOC_FAMILY_IMX
    depends on ARCH_ARMV7
    select DRIVERS_TZC380
    select DRIVERS_IMX_ROM_LOG
    select DRIVERS_IMX_HAB_LOG
config PLAT_IMXRT
    bool "NXP IMXRT"
    depends on SOC_FAMILY_IMX
    depends on ARCH_ARMV7M
    select DRIVERS_IMX_HAB_LOG
    select PLAT_CRYPTO_ENGINE

config PLAT_HOST
    bool "Host (native Linux process, for testing)"
    depends on ARCH_HOST
endchoice

source "src/plat/*/Kconfig"

menu "Memory"
    depends on !PLAT_HOST

config PB_ENTRY
    hex "Where pb is loaded and linked"
    help
        The address the ROM loads pb to, where pb is linked and entered
        (platform.md 5.1). The board's choice, in memory the ROM may load
        to: the platform's link script has the rule. It reaches the linker,
        the image stages and C. There is no default: a board's defconfig
        sets it, and a build without it stops.

config BOARD_DRAM_BASE
    hex "The board's DRAM: its address"
    default 0x0
    help
        The DRAM the board has, in one range (platform.md 5.1): what pb
        maps as the board's memory, and what the link checks pb's regions
        against. Images are loaded into the board's image data regions
        (board.md 2.9), not into all of it.

config BOARD_DRAM_SIZE
    hex "The board's DRAM: its size"
    default 0x0
    help
        0: the board has no DRAM, and pb, its buffers and the images are
        in the SoC's on-chip RAM.

config PB_BUFFERS_BASE
    hex "pb's buffers: their address"
    default 0x81021000 if PLAT_IMX6UL
    default 0x40060000 if PLAT_IMX8M_COMMON
    default 0x85000000 if PLAT_IMX8X_COMMON
    default 0x20289000 if PLAT_IMXRT
    help
        The buffers region (platform.md 5.1): what pb doesn't initialize,
        its transfer buffers and the translation tables. In memory that
        works after plat_init(), the board's DRAM or the SoC's on-chip RAM,
        and outside pb. The default is the platform's.

config PB_BUFFERS_SIZE
    hex "pb's buffers: their size"
    default 0x1000000 if PLAT_IMX6UL
    default 0x1000000 if PLAT_IMX8M_COMMON
    default 0x1000000 if PLAT_IMX8X_COMMON
    default 0x37000 if PLAT_IMXRT
    help
        The room the buffers have. The link fails when they need more. No
        image data region of the board's may reach into what is linked
        there (board.md 2.9).

endmenu

endmenu
