menu "i.MX8X options"
    depends on PLAT_IMX8X_COMMON

config IMX8X_FUSE_DRY_RUN
    bool "Fuse box: dry run"
    help
        Program no fuses: write each fuse's bank and value to the console
        instead.

endmenu

menu "Output image"
    depends on PLAT_IMX8X_COMMON

config IMX8X_CREATE_IMX_IMAGE
    bool "Create pb.imx"
    help
        pb.imx, the boot container with the SECO firmware, the SCU firmware
        and pb (plat-imx.md 6).

config IMX8X_SIGN_IMAGE
    bool "Sign it (AHAB)"
    depends on IMX8X_CREATE_IMX_IMAGE
    help
        pb_signed.imx, pb.imx signed for AHAB with NXP's cst.

config IMX8X_SRK_TABLE
    string "SRK table"
    default "pki/imx8x_ahab/crts/SRK_1_2_3_4_table.bin"
    depends on IMX8X_SIGN_IMAGE

config IMX8X_SIGN_CERT
    string "Signing certificate"
    default "pki/imx8x_ahab/crts/SRK1_sha384_secp384r1_v3_usr_crt.pem"
    depends on IMX8X_SIGN_IMAGE

config IMX8X_KEY_INDEX
    int "Key index (0-3)"
    default 0
    depends on IMX8X_SIGN_IMAGE

config IMX8X_KEY_REVOKE_MASK
    int "Revoked SRKs"
    default 0
    depends on IMX8X_SIGN_IMAGE
    help
        The bit mask of the revoked SRKs in the container's signature
        (Revocations in the CSF), as a decimal number.

endmenu
