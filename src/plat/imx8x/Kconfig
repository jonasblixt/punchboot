choice IMX8X_CM_USB
    bool "Command mode's USB port"
    depends on PLAT_IMX8X_COMMON && CM
    help
        The USB device port command mode uses. plat_cm_init() sets up its
        power, its clocks, its PHY and its controller when command mode
        starts (platform.md 3.10).

config IMX8X_CM_USB3
    bool "USB 3.0 (i.MX8QXP)"
    depends on PLAT_IMX8X
    select DRIVER_USB_DEVICE
    select DRIVER_USB_PB_CLS
    select DRIVER_IMX_CDNS3_UDC
    help
        The Cadence USB3 controller with its PHY, the SCFW's SC_R_USB_2.

config IMX8X_CM_USB_OTG2
    bool "USB OTG2 (i.MX8DXL)"
    depends on PLAT_IMX8XL
    select DRIVER_USB_DEVICE
    select DRIVER_USB_PB_CLS
    select DRIVER_IMX_USB2_PHY
    select DRIVER_IMX_CI_UDC
    help
        The second ChipIdea controller with its PHY, the SCFW's SC_R_USB_1.
endchoice

menu "imx8x configuration"
    depends on PLAT_IMX8X_COMMON
    comment "imx8x configuration"

config IMX8X_FUSE_DRY_RUN
    bool "Fusebox dry run"
    default n
    depends on PLAT_IMX8X_COMMON
    help
    Enabling this option will inhibit fuse programming and instead writing
    the fuse bank and value to the console.

endmenu

menu "Output image"
    depends on PLAT_IMX8X_COMMON
config IMX8X_CREATE_IMX_IMAGE
    bool "Create imx-image"
    default n

config IMX8X_SIGN_IMAGE
    bool "Sign image"
    default n
    depends on IMX8X_CREATE_IMX_IMAGE

config IMX8X_SRK_TABLE
    string "SRK Table binary"
    default "pki/imx8x_ahab/crts/SRK_1_2_3_4_table.bin"
    depends on IMX8X_SIGN_IMAGE

config IMX8X_SIGN_CERT
    string "Signing certificate"
    default "pki/imx8x_ahab/crts/SRK1_sha384_secp384r1_v3_usr_crt.pem"
    depends on IMX8X_SIGN_IMAGE

config IMX8X_KEY_INDEX
    int "Key index (0-3)"
    default 0
    depends on IMX8X_SIGN_IMAGE

config IMX8X_KEY_REVOKE_MASK
    int "Revoked SRKs"
    default 0
    depends on IMX8X_SIGN_IMAGE
    help
        The bit mask of the revoked SRKs in the container's signature
        (Revocations in the CSF), as a decimal number.

endmenu
