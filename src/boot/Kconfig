config BOOT_AB_DRIVER
    bool "A/B boot driver"
    help
        This is the default boot driver. It uses two block devices to store
        primary an backup configuration. It has support for rollback and
        error reporting.

config BOOT_LINUX
    bool "Linux boot support"

config BOOT_ATF
    bool "ATF boot support"
    depends on ARCH_ARMV8
    help
        This boot driver uses the Arm Trusted Firmware bootloader interface
        to boot the BL33 (and optional BL32) image.

        NOTE: Currently only supported on armv8.

config BOOT_DTB_HEADROOM
    int "Device tree headroom (bytes)"
    depends on BOOT_LINUX || BOOT_ATF
    default 4096
    help
        The Linux and ATF boot drivers add /chosen and pb's properties to the
        device tree: pb,device-uuid, pb,slc, pb,slc-active-key,
        pb,slc-available-keys, pb,active-system, the initrd and what the
        board's callback sets (bootargs). First they grow the device tree in
        place by this many bytes, into the RAM after its part. Leave that RAM
        free in the boot image: another part or pb there fails the boot.
        Growing moves the device tree's strings, which takes a little time; a
        device tree built with the properties and free space for them
        (dtc -p) doesn't need it, set 0 then.

config BOOT_ARMV7M_BAREMETAL
    bool "ARMv7m bare metal boot support"

config BOOT_LOAD_CHUNK_kB
    int "Copy/Hash load chunk size (kB)"
    default 4096

config BOOT_LINUX_RAMOOPS
    bool "Read Linux's ramoops console as the log 'linux'"
    help
        Linux's pstore/ramoops keeps the console of a boot in a reserved RAM
        region that survives a warm reset. With this, 'punchboot log linux'
        reads the console Linux left there, e.g. after a panic and a
        watchdog reset into command mode. pb only reads the region, before
        anything is loaded into it, and the values must match the ramoops
        node in the device tree (reserved-memory, ecc-size 0). A cold reset
        (power, or a PMIC that power cycles the DRAM on WDOG_B) loses it.

config BOOT_LINUX_RAMOOPS_ADDR
    hex "ramoops region address"
    depends on BOOT_LINUX_RAMOOPS

config BOOT_LINUX_RAMOOPS_SIZE
    hex "ramoops region size"
    depends on BOOT_LINUX_RAMOOPS

config BOOT_LINUX_RAMOOPS_RECORD_SIZE
    hex "ramoops record-size"
    depends on BOOT_LINUX_RAMOOPS
    default 0x0

config BOOT_LINUX_RAMOOPS_CONSOLE_SIZE
    hex "ramoops console-size"
    depends on BOOT_LINUX_RAMOOPS

config BOOT_LINUX_RAMOOPS_FTRACE_SIZE
    hex "ramoops ftrace-size"
    depends on BOOT_LINUX_RAMOOPS
    default 0x0

config BOOT_LINUX_RAMOOPS_PMSG_SIZE
    hex "ramoops pmsg-size"
    depends on BOOT_LINUX_RAMOOPS
    default 0x0
