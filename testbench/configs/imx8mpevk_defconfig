BR2_aarch64=y
BR2_cortex_a53=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_PB_TESTBENCH_PATH)/board/common/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y

# Toolchain: musl, kickstart is linked statically
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_SHARED_STATIC_LIBS=y

# System
BR2_TARGET_GENERIC_HOSTNAME="imx8mpevk"
BR2_TARGET_GENERIC_ISSUE="punchboot test bench (i.MX8M Plus EVK)"
BR2_TARGET_GENERIC_GETTY_PORT="ttymxc1"
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PB_TESTBENCH_PATH)/board/common/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_PB_TESTBENCH_PATH)/board/common/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_PB_TESTBENCH_PATH)/board/common/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="imx8mpevk"

# Linux, latest longterm
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.58"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_PB_TESTBENCH_PATH)/board/common/linux.fragment $(BR2_EXTERNAL_PB_TESTBENCH_PATH)/board/imx8mpevk/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
# imx8mp-evk.dts without the audio mix (board/imx8mpevk/dts)
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_PB_TESTBENCH_PATH)/board/imx8mpevk/dts"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Target packages
# BusyBox's watchdog daemon (S15watchdog) takes over the watchdog pb starts
BR2_PACKAGE_BUSYBOX_WATCHDOG=y
BR2_PACKAGE_MEMTESTER=y
BR2_PACKAGE_MMC_UTILS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_PBSTATE=y

# NXP's LPDDR4 training firmware (FW2020.06) for punchboot
BR2_PACKAGE_FREESCALE_IMX=y
BR2_PACKAGE_FREESCALE_IMX_PLATFORM_IMX8MP=y
BR2_PACKAGE_FIRMWARE_IMX=y
BR2_PACKAGE_FIRMWARE_IMX_LPDDR4=y
BR2_PACKAGE_FIRMWARE_IMX_DDR_VERSION="202006"

# kickstart in the initramfs, the root file system in a root image on
# Root A/B. The eMMC is on uSDHC3, mmcblk2 (the mmc2 alias in
# imx8mp.dtsi), the GPT is gpt_tbl_default in punchboot's
# src/board/imx8mpevk/board.c.
BR2_PACKAGE_KICKSTART=y
BR2_PACKAGE_KICKSTART_ROOT_A="/dev/mmcblk2p3"
BR2_PACKAGE_KICKSTART_ROOT_B="/dev/mmcblk2p4"
BR2_PACKAGE_KICKSTART_PBSTATE_PRIMARY="/dev/mmcblk2p5"
BR2_PACKAGE_KICKSTART_PBSTATE_BACKUP="/dev/mmcblk2p6"
BR2_TARGET_ROOTFS_SQUASHFS=y
# BR2_TARGET_ROOTFS_TAR is not set

# TF-A BL31, started by punchboot. The console is UART2.
BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="imx8mp"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_BL31=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_ADDITIONAL_VARIABLES="IMX_BOOT_UART_BASE=0x30890000"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_IMAGES="bl31.bin"

BR2_TARGET_PUNCHBOOT=y
BR2_TARGET_PUNCHBOOT_BOARD="imx8mpevk"
BR2_TARGET_PUNCHBOOT_IMX8M_DDR_FW=y
