# What the board needs, built in (no modules are loaded): the CAAM, the
# SCU's watchdog (TF-A's IMX_SIP_SRTC watchdog calls,
# board/imx8qxmek/patches/arm-trusted-firmware), thermal and RTC, the i.MX
# cpufreq driver
CONFIG_CRYPTO_DEV_FSL_CAAM=y
CONFIG_CRYPTO_DEV_FSL_CAAM_JR=y
CONFIG_IMX_SC_WDT=y
CONFIG_IMX_SC_THERMAL=y
CONFIG_RTC_DRV_IMX_SC=y
CONFIG_ARM_IMX_CPUFREQ_DT=y

# Networking: IPv4 only
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set

# File systems: ext4, VFAT and squashfs stay
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_AUTOFS_FS is not set
# CONFIG_QUOTA is not set

# The jitter entropy RNG and its DRBG (464 ms on jiffy). The arm64 defconfig
# sets ECHAINIV (IPsec), which pulls them in through GENIV and RNG_DEFAULT.
# CONFIG_CRYPTO_ECHAINIV is not set
# CONFIG_CRYPTO_ECDH is not set
# CONFIG_CRYPTO_DRBG_MENU is not set
# CONFIG_CRYPTO_JITTERENTROPY is not set

# No RAM disks, loop devices only on demand
# CONFIG_BLK_DEV_RAM is not set
CONFIG_BLK_DEV_LOOP_MIN_COUNT=0

# Debug and extras. The initramfs is gzip.
# CONFIG_KPROBES is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_IO_URING is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_IKCONFIG is not set
# CONFIG_SWAP is not set
# CONFIG_FTRACE is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
