# jiffy, on top of arch/arm/configs/imx_v6_v7_defconfig

# CPU supply, FAN5355 on I2C2 (patches/linux)
CONFIG_REGULATOR_FAN53555=y

# Ethernet PHY, LAN8710A
CONFIG_SMSC_PHY=y

# Boot time: only what jiffy has. Its DTS enables UART1-4 (nothing on them
# but the console), I2C1-2, FEC1, uSDHC1 (eMMC), ADC1, WDOG1, the SNVS and
# GPIO. Every MB less in the Image is ~50 ms less boot: the zImage
# decompresses itself at ~22 MB/s and pb reads it at 77 MiB/s.

# The i.MX6UL only, which also makes it an ARMv7-only kernel
# CONFIG_ARCH_MULTI_V6 is not set
# CONFIG_SOC_IMX31 is not set
# CONFIG_SOC_IMX35 is not set
# CONFIG_SOC_IMX50 is not set
# CONFIG_SOC_IMX51 is not set
# CONFIG_SOC_IMX53 is not set
# CONFIG_SOC_IMX6Q is not set
# CONFIG_SOC_IMX6SL is not set
# CONFIG_SOC_IMX6SLL is not set
# CONFIG_SOC_IMX6SX is not set
# CONFIG_SOC_IMX7D is not set
# CONFIG_SOC_IMX7ULP is not set
# CONFIG_SOC_VF610 is not set

# No display, sound, camera, radios, PCIe, SATA, NAND or USB devices
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_VT is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_RC_CORE is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_RFKILL is not set
# CONFIG_BT is not set
# CONFIG_CAN is not set
# CONFIG_PCI is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_MTD is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_HID is not set
# CONFIG_SPI is not set
# CONFIG_PWM is not set
# CONFIG_STAGING is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_MISC is not set

# Other boards' PMICs and companion chips
# CONFIG_MFD_DA9062 is not set
# CONFIG_MFD_DA9063 is not set
# CONFIG_MFD_MC13XXX is not set
# CONFIG_MFD_MC13XXX_I2C is not set
# CONFIG_MFD_RN5T618 is not set
# CONFIG_MFD_STMPE is not set
# CONFIG_MFD_SY7636A is not set
# CONFIG_MFD_WM8994 is not set

