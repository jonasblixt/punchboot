#!/usr/bin/env bash
#
# Copyright (C) 2026 Jonas Blixt <jonas@blxt.se>
#
# SPDX-License-Identifier: BSD-3-Clause
#
# Copies the part of the bpak library that punchboot uses from a release of
# bpak (doc/dev/bpak.md, "What is vendored"):
#
#   scripts/sync-bpak <version> [bpak repository]
#
# e.g. scripts/sync-bpak 1.0.1. The files are read from the tag v<version>
# of the repository (default ../bpak), whatever is checked out there, and
# formatted with punchboot's clang-format. They are not changed otherwise:
# what upstream generates at build time and the internal header are
# punchboot's own files (include/bpak/build_config.h, src/lib/internal.h),
# include/bpak/version.h records the version.
#
# Read doc/dev/compatibility.md before committing the result: a new bpak
# can change which headers the firmware accepts (D-024).

set -euo pipefail

cd "$(dirname "$0")/.."

version="${1:?Usage: $0 <version> [bpak repository]}"
upstream="${2:-../bpak}"
tag="v${version}"

if ! git -C "$upstream" rev-parse -q --verify "refs/tags/${tag}" > /dev/null; then
    echo "No tag ${tag} in ${upstream}" >&2
    exit 1
fi

# upstream path -> punchboot path
files=(
    "lib/bpak.c:src/lib/bpak.c"
    "include/bpak/bpak.h:include/bpak/bpak.h"
    "include/bpak/id.h:include/bpak/id.h"
    "include/bpak/key.h:include/bpak/key.h"
    "include/bpak/keystore.h:include/bpak/keystore.h"
)

out=()
for f in "${files[@]}"; do
    git -C "$upstream" show "${tag}:${f%%:*}" > "${f##*:}"
    out+=("${f##*:}")
done

# Generated by upstream's CMake from version.txt
IFS=. read -r major minor patch <<< "$version"
git -C "$upstream" show "${tag}:lib/version.h.in" \
    | sed -e "s/@PROJECT_VERSION_MAJOR@/${major}/" \
          -e "s/@PROJECT_VERSION_MINOR@/${minor}/" \
          -e "s/@PROJECT_VERSION_PATCH@/${patch}/" \
          -e "s/@PROJECT_VERSION@/${version}/" \
    > include/bpak/version.h
out+=(include/bpak/version.h)

# The clang-format of the pre-commit hook, it fails when it changed files
pre-commit run clang-format --files "${out[@]}" > /dev/null || true
pre-commit run clang-format --files "${out[@]}"

echo "Synced bpak ${version} (${tag}, $(git -C "$upstream" rev-parse --short "${tag}^{commit}"))."
echo "Check that src/lib/internal.h still has what src/lib/bpak.c uses, and run the tests."
